{
  "name": "petali-cloud",
  "version": "1.5.0",
  "private": true,
  "description": "Petali Cloud backend (Petali ID and account foundation)",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/src/db/migrate-cli.js up",
    "migrate:dev": "tsx src/db/migrate-cli.ts up",
    "migrate:status": "tsx src/db/migrate-cli.ts status",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
